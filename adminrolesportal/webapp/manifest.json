{
  "_version": "1.90.0",
  "sap.app": {
    "id": "com.claro.proveedores.adminrolesportal",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.34.0",
      "toolsId": "c78e3cde-616a-4550-8926-919ea45bcffb"
    },
    "dataSources": {
        "PORTAL_PROVEEDORES_REST": {
            "uri": "/PORTAL_PROVEEDORES_REST/",
            "type": "http"
        },
        "OdataServicePPC": {
          "uri": "/v2/OdataServicePPC/",
          "type": "OData",
          "settings": {
            "odataVersion": "2.0",
            "localUri": "localService/ZMM_PORTAL_PROVEEDORES_SRV/metadata.xml"
          }
        }
    },
    "crossNavigation": {
        "inbounds": {
            "semantic_AdminRoles-action_display": {
                "semanticObject": "AdministradorRoles",
                "action": "display",
                "title": "{{flpTitle}}",
                "icon": "sap-icon://role",
                "signature": {
                    "parameters": {},
                    "additionalParameters": "allowed"
                }
            }
        }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.154.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.claro.proveedores.adminrolesportal.i18n.i18n",
          "supportedLocales": ["","en"],
          "fallbackLocale": ""
        }
      },
      "modeloDatos": {
				"type": "sap.ui.model.odata.v2.ODataModel",
				"settings": {
					"defaultOperationMode": "Server",
					"defaultBindingMode": "OneWay",
					"defaultCountMode": "Request",
					"useBatch": false
				},
				"dataSource": "OdataServicePPC",
				"preload": true
			}
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "com.claro.proveedores.adminrolesportal.view",
        "async": true,
        "viewPath": "com.claro.proveedores.adminrolesportal.view"
      },
      "routes": [
        {
          "name": "view1",
          "pattern": ":?query:",
          "target": [
            "TargetView1"
          ]
        }
      ],
      "targets": {
        "TargetView1": {
          "id": "View1",
          "name": "View1"
        }
      }
    },
    "rootView": {
      "viewName": "com.claro.proveedores.adminrolesportal.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "z_admin_roles_portal"
  }
}
