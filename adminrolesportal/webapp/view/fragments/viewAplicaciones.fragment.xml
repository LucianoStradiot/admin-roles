<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout">
	<Dialog busyIndicatorDelay='0' title="{i18n>listaAplicaciones}" type='Message' contentWidth="436px">
		<content>
			<Toolbar>
				<Title id="titleAplicacionesAsignadasId" text="{i18n>appsAsignadas}" level="H2"/>
			</Toolbar>
			<ScrollContainer class="sapUiSmallMarginTop sapUiNoContentPadding" horizontal="false" vertical="true" height="400px">
				<l:Grid vSpacing="1" hSpacing="1" width="auto" content="{modelViewAplicacion>/}">
					<VBox height="16.9rem" class="borderGris">
						<Bar>
							<contentMiddle>
								<Label class="non-selectable cursorDefault" tooltip="{modelViewAplicacion>APPID_APPID} - {modelViewAplicacion>APPSMASTER_DESCRIPTION}" text="{modelViewAplicacion>APPID_APPID} - {modelViewAplicacion>APPSMASTER_DESCRIPTION}" design="Bold"></Label>
							</contentMiddle>
						</Bar>
						<Image width="100%" height="12.6rem" src="{modelViewAplicacion>URL}"></Image>
						<Toolbar class="non-selectable" design="Solid">
							<ScrollContainer width="100%" vertical="false" horizontal="true" content="{modelViewAplicacion>ACCIONES/}">
								<Label class="sapUiSmallMarginBegin" design="Bold" required="true" text="{modelViewAplicacion>ACCESSTEXT_DESCRIPTION}"></Label>
							</ScrollContainer>
						</Toolbar>
						<layoutData>
							<l:GridData span="XL12 L12 M12 S12"/>
						</layoutData>
					</VBox>
				</l:Grid>
			</ScrollContainer>
		</content>
		<endButton>
			<Button text="{i18n>close}" type="Transparent" press="closeListAplicacionesView"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>